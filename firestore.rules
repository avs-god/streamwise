rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function moderator() { return signedIn() && request.auth.token.admin == true; }
    function validReview() { return request.resource.data.body is string && request.resource.data.body.size() >= 20 && request.resource.data.body.size() <= 2000; }

    match /users/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if false;
      match /watchlist/{id} { allow read, write: if owner(uid); }
      match /subscriptions/{id} { allow read, write: if owner(uid); }
      match /alerts/{id} { allow read, write: if owner(uid); }
      match /preferences/{id} { allow read, write: if owner(uid); }
      match /availabilitySnapshots/{id} { allow read, write: if owner(uid); }
      match /viewingSignals/{id} { allow read, write: if owner(uid); }
    }

    match /communityThreads/{threadId} {
      allow read: if resource.data.status == 'visible' || moderator();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if moderator() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId);
      allow delete: if moderator();
      match /replies/{replyId} {
        allow read: if resource.data.status == 'visible' || moderator();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if moderator() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId);
        allow delete: if moderator();
      }
    }

    match /titleReviews/{reviewId} {
      allow read: if resource.data.status == 'visible' || moderator();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && validReview();
      allow update: if moderator() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId);
      allow delete: if moderator();
      match /helpfulVotes/{uid} { allow read: if signedIn(); allow create, update, delete: if owner(uid); }
    }
    match /titleRatings/{ratingId} { allow read: if true; allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid; allow delete: if moderator(); }
    match /moderation/{id} { allow read, write: if moderator(); }
  }
}
